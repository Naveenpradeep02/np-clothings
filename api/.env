# ============================================================
# AUREA API — copy to apps/api/.env (never commit real secrets)
# ============================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

APP_BASE_URL=http://localhost:4000
CUSTOMER_WEB_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5174
# CORS_EXTRA_ORIGINS=http://localhost:3000

# MySQL 8 (Aiven Cloud)
DB_HOST=mysql-68c07bd-naveenpradeep0987-861d.h.aivencloud.com
DB_PORT=21130
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=AVNS_l-WuP1dX9SuSEn8Sauu
DB_SSL=true
DATABASE_URL=mysql://avnadmin:AVNS_l-WuP1dX9SuSEn8Sauu@mysql-68c07bd-naveenpradeep0987-861d.h.aivencloud.com:21130/defaultdb?ssl-mode=REQUIRED

# Local Fallback (Docker/Local MySQL)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=aurea_commerce
# DB_USER=root
# DB_PASSWORD=naveen@123
# DATABASE_URL=mysql://aurea:change_me@127.0.0.1:3306/aurea_commerce
DB_POOL_LIMIT=10
# Set true in production so API refuses to boot without DB
DB_REQUIRED_ON_BOOT=false

# Firebase Admin (server only — never put private key in Vite env)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use \n for newlines when storing in a single line env value
FIREBASE_PRIVATE_KEY=

# Payment (wired in later phase)
PAYMENT_PROVIDER=razorpay
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PUBLIC_KEY=

# Notifications / courier (later phases)
SMS_PROVIDER=
SMS_PROVIDER_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_PROVIDER_KEY=
COURIER_PROVIDER=
COURIER_PROVIDER_KEY=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Dev-only auth bypass (NEVER in production). Token format: dev:<uid>|<email>|<name>
AUTH_DEV_BYPASS=true
